# .gitignore for ui project

# Ignore node_modules
node_modules/
# Ignore build output
dist/
build/
# Ignore logs
logs/
*.log
# Ignore environment variables
.env
# Ignore IDE files
.vscode/
.idea/
# Ignore OS files
.DS_Store
Thumbs.db

# Ignore coverage reports
coverage/   
# Ignore temporary files
*.tmp
*.temp
# Ignore lock files
package-lock.json
yarn.lock
# Ignore test snapshots
__snapshots__/
# Ignore generated files
*.generated.js
*.generated.ts
# Ignore cache
.cache/
